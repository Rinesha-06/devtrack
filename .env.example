# ============================================================
# DevTrack Environment Configuration Example
# Copy to .env for local development
# NEVER commit sensitive API keys or service account credentials
# ============================================================

# Server Port
PORT=8080

# Environment Mode: development | production | test
NODE_ENV=development

# Google Cloud Platform Configuration
GCP_PROJECT_ID=project-b2ff78e3-650d-4af6-9bb
GCP_REGION=asia-south1
FIRESTORE_DATABASE_ID=(default)

# Database Engine: 'false' for GCP Firestore, 'true' for local offline testing
USE_LOCAL_DB=false

# JWT Secret for Session Verification
JWT_SECRET=devtrack-secure-jwt-academic-secret-key-2026

# GitHub Integration (Optional: for private repo access or elevated rate limits)
GITHUB_TOKEN=
