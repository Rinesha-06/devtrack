rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to get requesting user record
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Helper to check user role
    function isRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role || 
        getUserData().role == role
      );
    }
    
    function isProjectManager() {
      return isRole('PROJECT_MANAGER');
    }
    
    function isDeveloper() {
      return isRole('DEVELOPER');
    }
    
    function isTester() {
      return isRole('TESTER');
    }

    // Users collection: readable by authenticated users; update self or PM
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (request.auth.uid == userId || isProjectManager());
    }

    // Projects: PM can create/update/delete; all authenticated members can read
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isProjectManager();
    }

    // Teams: readable by authenticated users; managed by Project Manager
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow write: if isProjectManager();
    }

    // Sprints: managed by Project Manager, readable by all members
    match /sprints/{sprintId} {
      allow read: if isAuthenticated();
      allow write: if isProjectManager();
    }

    // User Stories (Backlog): managed by PM, readable by all members
    match /userStories/{storyId} {
      allow read: if isAuthenticated();
      allow write: if isProjectManager();
    }

    // Tasks: PM creates and assigns; Developers & Testers update status
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create, delete: if isProjectManager();
      allow update: if isAuthenticated();
    }

    // Bugs: Testers and Developers report and transition
    match /bugs/{bugId} {
      allow read: if isAuthenticated();
      allow create: if isTester() || isProjectManager() || isDeveloper();
      allow update: if isAuthenticated();
      allow delete: if isProjectManager();
    }

    // Activities: Append-only audit logs
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit trail
    }

    // Notifications: Private to recipient
    match /notifications/{notifId} {
      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Builds & CI/CD Telemetry: Read-only for authenticated users
    match /builds/{buildId} {
      allow read: if isAuthenticated();
      allow write: if isProjectManager();
    }
  }
}
